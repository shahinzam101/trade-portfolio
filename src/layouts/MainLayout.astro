---
// src/layouts/MainLayout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import Footer from '../components/Footer.astro';
import content from '../data/content.json';

const lang: 'fa' | 'tr' =
  Astro.url.pathname === '/fa' || Astro.url.pathname.startsWith('/fa/')
    ? 'fa'
    : 'tr';

const dir = lang === 'fa' ? 'rtl' : 'ltr';
const info = content.companyInfo[lang] || content.companyInfo.tr;

const { title = info.name, description = info.shortIntro, hideBottomCTA = false } = Astro.props;
const pageTitle = title === info.name ? `${info.name} | ${info.legalTitle}` : `${title} | ${info.name}`;
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- لود همزمان فونت‌های Montserrat (ترکی) و Vazirmatn (فارسی) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body class={`min-h-screen flex flex-col bg-brand-bg text-brand-text selection:bg-brand-gold selection:text-brand-bg ${lang === 'fa' ? 'font-vazir' : 'font-montserrat'}`}>
    <Navbar />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <WhatsAppCTA hideSection={hideBottomCTA} />
    <Footer />
  </body>
</html>