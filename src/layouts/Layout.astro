---
// src/layouts/MainLayout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { companyInfo } from '../data/projects.js';

// دریافت عنوان صفحه به عنوان ورودی (Prop)
const { title = companyInfo.name } = Astro.props;
---

<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {companyInfo.name}</title>
    
    <!-- بارگذاری فونت وزیرمتن از گوگل فونت با وزن‌های مختلف -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  
  
<body class="min-h-screen flex flex-col selection:bg-[var(--color-accent)] selection:text-[var(--color-accent-foreground)]">
  
    <!-- افکت نوری زرد/طلایی بسیار ملایم در بالای سایت (سبک مدرن اپل) -->
    <!-- <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] h-[250px] bg-amber-500/10 blur-[130px] pointer-events-none -z-10"></div> -->

    <!-- نوبار شیشه‌ای بالای صفحه -->
    <Navbar />

    <!-- محتوای متغیر هر صفحه اینجا قرار می‌گیرد -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- فوتر سایت -->
    <Footer />

  </body>
</html>