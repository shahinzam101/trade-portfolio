---
// src/pages/tr/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('tr');
---

<MainLayout title="Aygun Ticaret | Uluslararası İhracat">
  
  <section class="py-24 border-b border-brand-border bg-brand-bg">
    <div class="container-editorial">
      
      <span class="text-xs font-semibold text-brand-gold tracking-widest uppercase">
        {t('hero.badge')}
      </span>

      <h1 class="text-3xl sm:text-5xl font-bold mt-3 text-brand-text">
        {t('hero.tagline')}
      </h1>

      <p class="mt-4 text-brand-secondary max-w-xl text-base leading-relaxed">
        Türkiye ve bölge ülkelerine yönelik tedarik, gümrükleme ve uluslararası lojistik süreçlerinin profesyonel yönetimi.
      </p>

      <div class="mt-8">
        <a href="https://wa.me/989120000000" target="_blank" class="btn-primary">
          {t('btn.consultation')}
        </a>
      </div>

    </div>
  </section>

</MainLayout>