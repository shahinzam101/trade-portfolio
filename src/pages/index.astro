---
// src/pages/index.astro
import { projects } from '../data/projects.js';
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>پورتفولیو بازرگانی و صادرات</title>
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-amber-500 selection:text-black">
    
    <!-- بخش معرفی (Hero) -->
    <header class="max-w-5xl mx-auto px-6 py-16 border-b border-slate-800">
      <span class="text-amber-400 text-sm font-semibold tracking-wider">بازرگانی بین‌المللی و صادرات</span>
      <h1 class="text-3xl md:text-5xl font-bold mt-2 leading-tight">سوابق اجرایی و محموله‌های صادراتی</h1>
      <p class="text-slate-400 mt-4 max-w-2xl leading-relaxed">
        تأمین کالا، انجام تشریفات گمرکی، لجستیک بین‌المللی و صادرات مستقیم به کشورهای همسایه و حوزه خلیج فارس.
      </p>
    </header>

    <!-- لیست پروژه‌ها -->
    <main class="max-w-5xl mx-auto px-6 py-12">
      <h2 class="text-xl font-bold mb-8 text-slate-200">پروژه‌های انجام شده</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projects.map((item) => (
          <a href={`/projects/${item.slug}`} class="group bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-amber-500/50 transition-all duration-300">
            <div class="aspect-video overflow-hidden bg-slate-800">
              <img src={item.coverImage} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6">
              <div class="flex justify-between items-center text-xs text-amber-400 mb-2">
                <span>{item.category}</span>
                <span>{item.destination}</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">{item.title}</h3>
              <p class="text-slate-400 text-sm mt-2 line-clamp-2 leading-relaxed">{item.summary}</p>
              <span class="inline-block mt-4 text-xs font-semibold text-slate-300 group-hover:translate-x-[-4px] transition-transform">
                مشاهده جزئیات و تصاویر &larr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </main>

  </body>
</html>