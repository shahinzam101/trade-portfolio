---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.js';
---

<MainLayout title="پورتفولیو و سوابق صادراتی">
  
  <Hero />

  <section id="projects" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    
    <!-- تیتر بخش پروژه‌ها با انیمیشن اسکرول -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 sm:mb-12 reveal">
      <div>
        <span class="text-amber-400 text-xs font-bold tracking-wider">پرونده‌های اجرایی</span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-2">محموله‌ها و پروژه‌های انجام شده</h2>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 mt-2 sm:mt-0">
        برای مشاهده تصاویر بارگیری و جزئیات گمرکی روی هر پروژه کلیک کنید.
      </p>
    </div>

    <!-- گرید کارت‌ها با ظاهر شدن ترتیبی هنگام اسکرول -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {projects.map((project, index) => (
        <div class={`reveal delay-${(index % 3) * 100}`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

  </section>

</MainLayout>