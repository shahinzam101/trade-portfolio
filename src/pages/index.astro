---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.js';
---

<MainLayout title="پورتفولیو و سوابق صادراتی">
  
  <!-- ۱. بخش معرفی بالای صفحه -->
  <Hero />

  <!-- ۲. بخش گرید پروژه‌ها -->
  <section id="projects" class="max-w-6xl mx-auto px-6 py-20">
    
    <!-- تیتر بخش پروژه‌ها -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 animate-apple-in delay-100">
      <div>
        <span class="text-amber-400 text-xs font-bold tracking-wider uppercase">پرونده‌های اجرایی</span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-2">محموله‌ها و پروژه‌های انجام شده</h2>
      </div>
      <p class="text-sm text-zinc-400 mt-2 sm:mt-0">
        برای مشاهده تصاویر بارگیری و جزئیات گمرکی روی هر پروژه کلیک کنید.
      </p>
    </div>

    <!-- شبکه کارت‌ها (Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 animate-apple-in delay-200">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

  </section>

</MainLayout>