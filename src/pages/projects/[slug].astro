---
// src/pages/projects/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  const langList: ('fa' | 'tr')[] = ['tr', 'fa'];

  return langList.flatMap((lang) => {
    const list = projects[lang] || [];
    return list.map((project: any) => ({
      params: { slug: project.slug },
      props: { project, lang },
    }));
  });
}

const { project, lang = ((Astro.currentLocale || 'tr') as 'fa' | 'tr') } = Astro.props;

const projectList = (projects[lang] || projects.tr) as any[];
const otherProjects = projectList.filter((item: any) => item.slug !== project.slug).slice(0, 2);

const ui = {
  fa: {
    home: "صفحه اصلی",
    projects: "پروژه‌ها",
    specTitle: "مشخصات کلیدی محموله",
    dest: "مقصد صادرات",
    prodType: "نوع محصول",
    vol: "حجم / تعداد محموله",
    transType: "روش حمل‌ونقل",
    customs: "گمرک مبدأ",
    time: "بازه زمانی",
    services: "خدمات ارائه‌شده",
    processTitle: "شرح فرآیند و عملیات اجرایی",
    outcomeTitle: "نتیجه عملیات",
    stepsTitle: "مراحل اجرایی انجام‌شده",
    galleryTitle: "تصاویر تکمیلی فرآیند آماده‌سازی و حمل",
    otherTitle: "سایر پروژه‌های صادراتی",
    backLink: "بازگشت به فهرست تمام پروژه‌ها",
    arrow: "←"
  },
  tr: {
    home: "Ana Sayfa",
    projects: "Projeler",
    specTitle: "Sevkiyat Temel Özellikleri",
    dest: "İhracat Hedefi",
    prodType: "Ürün Türü",
    vol: "Miktar / Hacim",
    transType: "Taşıma Yöntemi",
    customs: "Çıkış Gümrüğü",
    time: "Zaman Dilimi",
    services: "Sağlanan Hizmetler",
    processTitle: "Süreç ve Operasyon Detayları",
    outcomeTitle: "Operasyon Sonucu",
    stepsTitle: "Uygulanan Operasyon Adımları",
    galleryTitle: "Hazırlık ve Sevkiyat Görselleri",
    otherTitle: "Diğer İhracat Projeleri",
    backLink: "Tüm Projeler Listesine Dön",
    arrow: "→"
  }
};

const t = ui[lang];

const specifications = [
  { label: t.dest, value: project.clientLocation },
  { label: t.prodType, value: project.productType },
  { label: t.vol, value: project.volume },
  { label: t.transType, value: project.transportType },
  { label: t.customs, value: project.customsOrigin },
  { label: t.time, value: project.date },
  { label: t.services, value: project.servicesProvided }
].filter((spec) => Boolean(spec.value));

const homeHref = lang === 'fa' ? '/fa' : '/';
const projectsHref = lang === 'fa' ? '/fa#projects' : '/#projects';
---

<MainLayout title={project.title} description={project.summary}>
  
  <article class="py-12 sm:py-16 bg-brand-bg">
    <div class="container-editorial">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8 text-[13px] text-brand-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href={homeHref} class="hover:text-brand-text transition-colors">{t.home}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={projectsHref} class="hover:text-brand-text transition-colors">{t.projects}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-secondary truncate max-w-[260px] sm:max-w-none" aria-current="page">
            {project.title}
          </li>
        </ol>
      </nav>

      <!-- هدر پروژه -->
      <header class="max-w-3xl mb-10">
        <p class="text-[13px] font-medium text-brand-gold mb-2.5">
          {project.category}
        </p>
        <h1 class="text-[28px] sm:text-[38px] lg:text-[42px] font-bold text-brand-text leading-[1.3]">
          {project.title}
        </h1>
        <p class="mt-4 text-[16px] sm:text-[17px] text-brand-secondary leading-[1.8]">
          {project.summary}
        </p>
      </header>

      <!-- تصویر اصلی -->
      <figure class="mb-12">
        <div class="rounded-[12px] overflow-hidden border border-brand-border bg-brand-surface aspect-[16/9] max-h-[520px]">
          <img
            src={project.coverImage}
            alt={project.coverAlt || project.title}
            class="w-full h-full object-cover object-center"
          />
        </div>
      </figure>

      <!-- مشخصات کلیدی محموله -->
      <section aria-label={t.specTitle} class="mb-14 surface-card p-6 sm:p-8">
        <h2 class="text-[16px] font-bold text-brand-text pb-4 mb-6 border-b border-brand-border">
          {t.specTitle}
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-6 gap-x-8">
          {specifications.map((spec) => (
            <div class="border-b border-brand-border/60 pb-4 sm:border-b-0 sm:pb-0">
              <dt class="text-[12px] text-brand-muted">{spec.label}</dt>
              <dd class="text-[15px] font-semibold text-brand-text mt-1">{spec.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- شرح فرآیند و مراحل اجرایی -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14 items-start">
        
        <section class="lg:col-span-7">
          <h2 class="text-[22px] font-bold text-brand-text mb-5">
            {t.processTitle}
          </h2>
          <div class="space-y-4 text-[15px] sm:text-[16px] text-brand-secondary leading-[1.9] text-justify">
            {Array.isArray(project.fullDescription) ? (
              project.fullDescription.map((paragraph: string) => <p>{paragraph}</p>)
            ) : (
              <p>{project.fullDescription}</p>
            )}
          </div>

          {project.documentedOutcome && (
            <div class="mt-8 pt-6 border-t border-brand-border">
              <h3 class="text-[15px] font-bold text-brand-text mb-2">
                {t.outcomeTitle}
              </h3>
              <p class="text-[14px] sm:text-[15px] text-brand-secondary leading-relaxed">
                {project.documentedOutcome}
              </p>
            </div>
          )}
        </section>

        {project.operationalSteps && project.operationalSteps.length > 0 && (
          <aside class="lg:col-span-5 surface-card p-6 sm:p-7">
            <h2 class="text-[17px] font-bold text-brand-text pb-4 mb-5 border-b border-brand-border">
              {t.stepsTitle}
            </h2>
            <ol class="space-y-4">
              {project.operationalSteps.map((step: string, index: number) => (
                <li class="flex items-start gap-3.5 text-[14px] text-brand-secondary leading-[1.75]">
                  <span class="w-6 h-6 rounded-[6px] bg-brand-elevated border border-brand-border-strong text-brand-text text-[12px] font-semibold flex items-center justify-center shrink-0 mt-0.5">
                    {index + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </aside>
        )}

      </div>

      <!-- تصاویر تکمیلی -->
      {project.gallery && project.gallery.length > 0 && (
        <section class="mb-16 pt-10 border-t border-brand-border">
          <h2 class="text-[20px] font-bold text-brand-text mb-6">
            {t.galleryTitle}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {project.gallery.map((item: any) => {
              const imgUrl = typeof item === 'string' ? item : item.url;
              const imgAlt = typeof item === 'string' ? project.title : item.alt;
              return (
                <figure class="rounded-[12px] overflow-hidden border border-brand-border bg-brand-surface aspect-[16/10]">
                  <img
                    src={imgUrl}
                    alt={imgAlt}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-center"
                  />
                </figure>
              );
            })}
          </div>
        </section>
      )}

      <!-- سایر پروژه‌ها -->
      <section class="pt-10 border-t border-brand-border">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
          <h2 class="text-[18px] font-bold text-brand-text">
            {t.otherTitle}
          </h2>
          <a
            href={projectsHref}
            class="inline-flex items-center gap-2 text-[13px] font-medium text-brand-secondary hover:text-brand-text transition-colors"
          >
            <span aria-hidden="true">{t.arrow}</span>
            <span>{t.backLink}</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {otherProjects.map((other: any) => (
            <a
              href={`/projects/${other.slug}`}
              class="group block surface-card surface-card-interactive p-5"
            >
              <div class="flex items-center justify-between text-[12px] text-brand-muted mb-2">
                <span>{other.category}</span>
                <span>{other.clientLocation}</span>
              </div>
              <h3 class="text-[16px] font-bold text-brand-text group-hover:text-brand-gold transition-colors">
                {other.title}
              </h3>
            </a>
          ))}
        </div>
      </section>

    </div>
  </article>

</MainLayout>