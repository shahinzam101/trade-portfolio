---
// src/pages/projects/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';
import content from '../../data/content.json';

export function getStaticPaths() {
  return content.projects.tr.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const otherProjects = content.projects.tr
  .filter((item) => item.slug !== project.slug)
  .slice(0, 2);

const t = {
  home: "Ana Sayfa",
  projects: "Projeler",
  specTitle: "Sevkiyat Temel Özellikleri",
  dest: "İhracat Hedefi",
  prodType: "Ürün Türü",
  vol: "Miktar / Hacim",
  transType: "Taşıma Yöntemi",
  customs: "Çıkış Gümrüğü",
  time: "Zaman Dilimi",
  services: "Sağlanan Hizmetler",
  processTitle: "Süreç ve Operasyon Detayları",
  outcomeTitle: "Operasyon Sonucu",
  stepsTitle: "Uygulanan Operasyon Adımları",
  galleryTitle: "Hazırlık ve Sevkiyat Görselleri",
  otherTitle: "Diğer İhracat Projeleri",
  backLink: "Tüm Projeler Listesine Dön",
  arrow: "→"
};

const specifications = [
  { label: t.dest, value: project.clientLocation },
  { label: t.prodType, value: project.productType },
  { label: t.vol, value: project.volume },
  { label: t.transType, value: project.transportType },
  { label: t.customs, value: project.customsOrigin },
  { label: t.time, value: project.date },
  { label: t.services, value: project.servicesProvided }
].filter((spec) => Boolean(spec.value));
---

<MainLayout title={project.title} description={project.summary}>
  <article class="py-8 sm:py-16 bg-brand-bg">
    <div class="container-editorial">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 sm:mb-8 text-[12px] sm:text-[13px] text-brand-muted">
        <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          <li><a href="/" class="hover:text-brand-text py-1 transition-colors">{t.home}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#projects" class="hover:text-brand-text py-1 transition-colors">{t.projects}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-secondary truncate max-w-[200px] sm:max-w-none" aria-current="page">{project.title}</li>
        </ol>
      </nav>

      <!-- هدر پروژه -->
      <header class="max-w-3xl mb-7 sm:mb-10">
        <p class="text-[12px] sm:text-[13px] font-medium text-brand-gold mb-2">{project.category}</p>
        <h1 class="text-[22px] sm:text-[36px] lg:text-[40px] font-bold text-brand-text leading-[1.3] text-balance">
          {project.title}
        </h1>
        <p class="mt-3 sm:mt-4 text-[14.5px] sm:text-[16.5px] text-brand-secondary leading-[1.8]">
          {project.summary}
        </p>
      </header>

      <!-- تصویر اصلی -->
      <figure class="mb-8 sm:mb-12">
        <div class="rounded-[12px] overflow-hidden border border-brand-border bg-brand-surface aspect-[16/10] sm:aspect-[16/9] max-h-[520px]">
          <img src={project.coverImage} alt={project.coverAlt || project.title} class="w-full h-full object-cover object-center" />
        </div>
      </figure>

      <!-- مشخصات کلیدی: در موبایل به صورت ردیف‌های منظم کلید-مقدار -->
      <section aria-label={t.specTitle} class="mb-10 sm:mb-14 surface-card p-5 sm:p-8">
        <h2 class="text-[15px] sm:text-[16px] font-bold text-brand-text pb-3.5 sm:pb-4 mb-4 sm:mb-6 border-b border-brand-border">
          {t.specTitle}
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-3.5 sm:gap-y-6 gap-x-8">
          {specifications.map((spec) => (
            <div class="flex flex-col sm:block border-b border-brand-border/50 pb-3 last:border-b-0 last:pb-0 sm:border-b-0 sm:pb-0">
              <dt class="text-[11.5px] sm:text-[12px] text-brand-muted">{spec.label}</dt>
              <dd class="text-[14px] sm:text-[15px] font-semibold text-brand-text mt-0.5 sm:mt-1">{spec.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- شرح فرآیند و عملیات -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 mb-12 sm:mb-14 items-start">
        <section class="lg:col-span-7">
          <h2 class="text-[19px] sm:text-[22px] font-bold text-brand-text mb-4 sm:mb-5">{t.processTitle}</h2>
          <div class="space-y-4 text-[14.5px] sm:text-[16px] text-brand-secondary leading-[1.85] sm:leading-[1.9]">
            {project.fullDescription.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {project.documentedOutcome && (
            <div class="mt-7 sm:mt-8 p-4 sm:p-5 rounded-[10px] bg-brand-surface/60 border border-brand-border">
              <h3 class="text-[14px] sm:text-[15px] font-bold text-brand-text mb-1.5">{t.outcomeTitle}</h3>
              <p class="text-[13.5px] sm:text-[14.5px] text-brand-secondary leading-relaxed">{project.documentedOutcome}</p>
            </div>
          )}
        </section>

        {project.operationalSteps && project.operationalSteps.length > 0 && (
          <aside class="lg:col-span-5 surface-card p-5 sm:p-7">
            <h2 class="text-[16px] sm:text-[17px] font-bold text-brand-text pb-3.5 sm:pb-4 mb-4 sm:mb-5 border-b border-brand-border">
              {t.stepsTitle}
            </h2>
            <ol class="space-y-3.5 sm:space-y-4">
              {project.operationalSteps.map((step, index) => (
                <li class="flex items-start gap-3 text-[13.5px] sm:text-[14px] text-brand-secondary leading-[1.75]">
                  <span class="w-6 h-6 rounded-[6px] bg-brand-elevated border border-brand-border-strong text-brand-text text-[11.5px] font-semibold flex items-center justify-center shrink-0 mt-0.5">
                    {index + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </aside>
        )}
      </div>

      <!-- تصاویر تکمیلی -->
      {project.gallery && project.gallery.length > 0 && (
        <section class="mb-12 sm:mb-16 pt-8 sm:pt-10 border-t border-brand-border">
          <h2 class="text-[18px] sm:text-[20px] font-bold text-brand-text mb-5 sm:mb-6">{t.galleryTitle}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {project.gallery.map((item) => (
              <figure class="rounded-[12px] overflow-hidden border border-brand-border bg-brand-surface aspect-[16/10]">
                <img src={item.url} alt={item.alt} loading="lazy" decoding="async" class="w-full h-full object-cover object-center" />
              </figure>
            ))}
          </div>
        </section>
      )}

      <!-- سایر پروژه‌ها -->
      <section class="pt-8 sm:pt-10 border-t border-brand-border">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 sm:mb-8">
          <h2 class="text-[17px] sm:text-[18px] font-bold text-brand-text">{t.otherTitle}</h2>
          <a href="/#projects" class="inline-flex items-center gap-2 text-[13px] font-medium text-brand-secondary hover:text-brand-text py-1 transition-colors">
            <span>{t.backLink}</span>
            <span aria-hidden="true">{t.arrow}</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
          {otherProjects.map((other) => (
            <a href={`/projects/${other.slug}`} class="group block surface-card surface-card-interactive p-4.5 sm:p-5">
              <div class="flex items-center justify-between text-[11.5px] sm:text-[12px] text-brand-muted mb-1.5">
                <span>{other.category}</span>
                <span>{other.clientLocation}</span>
              </div>
              <h3 class="text-[15px] sm:text-[16px] font-bold text-brand-text group-hover:text-brand-secondary transition-colors">
                {other.title}
              </h3>
            </a>
          ))}
        </div>
      </section>

    </div>
  </article>
</MainLayout>