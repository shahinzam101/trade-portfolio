---
// src/components/Footer.astro
import { companyInfo } from '../data/projects.js';
---

<footer class="border-t border-white/[0.08] bg-black/40 mt-20">
  <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col sm:flex-row items-center justify-between gap-6 text-sm text-zinc-500">
    <div>
      <span class="font-bold text-zinc-200">{companyInfo.name}</span> — تمامی حقوق محفوظ است.
    </div>
    <div class="flex gap-6 text-zinc-400">
      <span>{companyInfo.location}</span>
    </div>
  </div>
</footer>