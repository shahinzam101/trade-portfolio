---
// src/components/Footer.astro
import { companyInfo } from '../data/projects.js';
---

<footer class="border-t border-brand-border bg-brand-bg pt-14 pb-20 sm:pb-14 text-[14px]">
  <div class="container-editorial">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-brand-border">
      
      <!-- معرفی شرکت (5 ستون) -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-[8px] bg-brand-surface border border-brand-border-strong flex items-center justify-center text-brand-text font-bold text-sm">
            آ
          </div>
          <span class="text-[16px] font-bold text-brand-text">{companyInfo.name}</span>
        </div>
        <p class="text-brand-secondary text-[13.5px] leading-[1.85] max-w-sm">
          {companyInfo.shortIntro}
        </p>
        <p class="text-brand-muted text-[12px] mt-4">
          {companyInfo.location}
        </p>
      </div>

      <!-- دسترسی سریع (3 ستون) -->
      <div class="md:col-span-3">
        <h3 class="text-[13.5px] font-bold text-brand-text mb-4">دسترسی سریع</h3>
        <ul class="space-y-2.5 text-[13px] text-brand-secondary">
          <li><a href="/" class="hover:text-brand-text hover:underline underline-offset-4 transition-colors">صفحه اصلی</a></li>
          <li><a href="/#services" class="hover:text-brand-text hover:underline underline-offset-4 transition-colors">خدمات بازرگانی</a></li>
          <li><a href="/#projects" class="hover:text-brand-text hover:underline underline-offset-4 transition-colors">پروژه‌های انجام‌شده</a></li>
          <li><a href="/#about" class="hover:text-brand-text hover:underline underline-offset-4 transition-colors">درباره شرکت</a></li>
        </ul>
      </div>

      <!-- راه‌های ارتباطی (4 ستون) -->
      <div class="md:col-span-4">
        <h3 class="text-[13.5px] font-bold text-brand-text mb-4">اطلاعات تماس</h3>
        <ul class="space-y-2.5 text-[13px] text-brand-secondary">
          <li>
            <span class="text-brand-muted">تلفن: </span>
            <a href={companyInfo.phoneHref} class="text-brand-secondary hover:text-brand-text transition-colors">
              {companyInfo.phoneDisplay}
            </a>
          </li>
          <li>
            <span class="text-brand-muted">واتس‌اپ بازرگانی: </span>
            <a
              href={companyInfo.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-secondary hover:text-brand-text underline underline-offset-4 decoration-brand-border hover:decoration-brand-text transition-colors"
            >
              ارسال پیام مستقیم &larr;
            </a>
          </li>
          <li>
            <span class="text-brand-muted">پست الکترونیک: </span>
            <a href={`mailto:${companyInfo.email}`} class="text-brand-secondary hover:text-brand-text transition-colors">
              {companyInfo.email}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- اطلاعات حقوقی -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[12px] text-brand-muted">
      <p>© ۱۴۰۵ {companyInfo.legalTitle}. تمامی حقوق محفوظ است.</p>
      <p>طراحی و توسعه بر پایه استانداردهای تجارت بین‌الملل</p>
    </div>

  </div>
</footer>