---
// src/components/Services.astro
import content from '../data/content.json';

const lang: 'fa' | 'tr' =
  Astro.url.pathname === '/fa' || Astro.url.pathname.startsWith('/fa/')
    ? 'fa'
    : 'tr';

const currentServices = content.services[lang];

const ui = {
  fa: {
    title1: "خدمات بازرگانی",
    title2: "حوزه‌های تخصصی و اجرایی شرکت",
    desc: "فرآیند صادرات نیازمند هماهنگی دقیق میان تولیدکننده، گمرک و ناوگان حمل‌ونقل است. خدمات ما زنجیره عملیات تجاری را به‌صورت یکپارچه پوشش می‌دهد."
  },
  tr: {
    title1: "Ticari Hizmetler",
    title2: "Uzmanlık Alanlarımız ve Faaliyetlerimiz",
    desc: "İhracat süreci, üretici, gümrük ve nakliye filosu arasında hassas bir koordinasyon gerektirir. Hizmetlerimiz ticari operasyon zincirini entegre bir şekilde kapsar."
  }
};
const t = ui[lang];
---

<section id="services" class="py-14 sm:py-24 border-b border-brand-border bg-brand-surface">
  <div class="container-editorial">
    
    <div class="max-w-2xl mb-8 sm:mb-12">
      <p class="text-[12px] sm:text-[12.5px] font-medium text-brand-muted mb-1.5 sm:mb-2">{t.title1}</p>
      <h2 class="text-[22px] sm:text-[32px] font-bold text-brand-text leading-snug">{t.title2}</h2>
      <p class="text-[14px] sm:text-[15px] text-brand-secondary mt-2.5 sm:mt-3 leading-relaxed">{t.desc}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-5">
      {currentServices.map((service, index) => (
        <div class="p-5 sm:p-7 rounded-[12px] bg-brand-bg border border-brand-border flex flex-col justify-between transition-colors hover:border-brand-border-strong">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-[6px] bg-brand-surface border border-brand-border text-[11.5px] font-semibold text-brand-muted">
                {lang === 'fa' ? `۰${index + 1}` : `0${index + 1}`}
              </span>
            </div>
            <h3 class="text-[16.5px] sm:text-[18px] font-bold text-brand-text">{service.title}</h3>
            <p class="text-[13.5px] sm:text-[15px] text-brand-secondary mt-2.5 leading-[1.8]">{service.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>