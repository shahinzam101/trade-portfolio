---
// src/components/Services.astro
import { services } from '../data/projects.js';
---

<section id="services" class="py-20 sm:py-24 border-b border-brand-border bg-brand-surface">
  <div class="container-editorial">
    
    <div class="max-w-2xl mb-12">
      <p class="text-[12.5px] font-medium text-brand-muted mb-2">
        خدمات بازرگانی
      </p>
      <h2 class="text-[26px] sm:text-[32px] font-bold text-brand-text leading-snug">
        حوزه‌های تخصصی و اجرایی شرکت
      </h2>
      <p class="text-[15px] text-brand-secondary mt-3 leading-relaxed">
        فرآیند صادرات نیازمند هماهنگی دقیق میان تولیدکننده، گمرک و ناوگان حمل‌ونقل است. خدمات ما زنجیره عملیات تجاری را به‌صورت یکپارچه پوشش می‌دهد.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 border-t border-r border-brand-border rounded-[12px] overflow-hidden bg-brand-bg">
      {services.map((service, index) => (
        <div class="p-6 sm:p-8 border-b border-l border-brand-border flex flex-col justify-between transition-colors hover:bg-brand-surface/40">
          <div>
            <span class="text-[12px] font-medium text-brand-muted block mb-2.5">
              ۰{index + 1}
            </span>
            <h3 class="text-[18px] font-bold text-brand-text">
              {service.title}
            </h3>
            <p class="text-[14px] sm:text-[15px] text-brand-secondary mt-3 leading-[1.8]">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>