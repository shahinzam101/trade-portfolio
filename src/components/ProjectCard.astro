---
// src/components/ProjectCard.astro
const { project } = Astro.props;
---

<article class="group surface-card surface-card-interactive flex flex-col overflow-hidden h-full">
  
  <a
    href={`/projects/${project.slug}`}
    tabindex="-1"
    aria-hidden="true"
    class="block aspect-[16/10] w-full overflow-hidden bg-brand-elevated border-b border-brand-border"
  >
    <img
      src={project.coverImage}
      alt={project.coverAlt || project.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-center transition-transform duration-200 ease-out group-hover:scale-[1.02]"
    />
  </a>

  <div class="p-6 flex flex-col flex-grow justify-between">
    <div>
      <div class="flex items-center justify-between gap-2 text-[12px] text-brand-secondary mb-2.5">
        <span>{project.category}</span>
        <span class="text-brand-muted">•</span>
        <span>مقصد: {project.clientLocation}</span>
      </div>

      <h3 class="text-[18px] font-bold text-brand-text leading-snug">
        <a
          href={`/projects/${project.slug}`}
          class="hover:text-brand-secondary transition-colors focus:outline-none"
        >
          {project.title}
        </a>
      </h3>

      <p class="mt-3 text-[14px] text-brand-secondary line-clamp-2 leading-[1.75]">
        {project.summary}
      </p>
    </div>

    <div class="mt-6 pt-4 border-t border-brand-border flex items-center justify-between">
      <span class="text-[12px] text-brand-muted">{project.date}</span>
      <a
        href={`/projects/${project.slug}`}
        class="inline-flex items-center gap-1.5 text-[13px] font-medium text-brand-secondary group-hover:text-brand-text transition-colors"
      >
        <span>جزئیات پروژه</span>
        <span aria-hidden="true" class="transition-transform duration-150 group-hover:-translate-x-1">&larr;</span>
      </a>
    </div>
  </div>

</article>