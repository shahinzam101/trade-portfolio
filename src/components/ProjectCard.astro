---
// src/components/ProjectCard.astro
const { project } = Astro.props;

const lang = (Astro.url.pathname.startsWith('/fa') ? 'fa' : 'tr') as 'fa' | 'tr';

const ui = {
  fa: {
    dest: "مقصد:",
    details: "جزئیات پروژه",
    arrow: "←",
    baseUrl: "/fa/projects"
  },
  tr: {
    dest: "Hedef:",
    details: "Proje Detayları",
    arrow: "→",
    baseUrl: "/projects"
  }
};

const t = ui[lang];
const projectUrl = `${t.baseUrl}/${project.slug}`;
---

<article class="group surface-card surface-card-interactive flex flex-col overflow-hidden h-full relative">
  
  <a
    href={projectUrl}
    class="block aspect-[16/10] w-full overflow-hidden bg-brand-elevated border-b border-brand-border"
  >
    <img
      src={project.coverImage}
      alt={project.coverAlt || project.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-center transition-transform duration-300 ease-out group-hover:scale-[1.02]"
    />
  </a>

  <div class="p-5 sm:p-6 flex flex-col flex-grow justify-between">
    <div>
      <div class="flex flex-wrap items-center justify-between gap-1.5 text-[11.5px] sm:text-[12px] text-brand-secondary mb-2">
        <span class="truncate">{project.category}</span>
        <span class="text-brand-muted">{t.dest} {project.clientLocation}</span>
      </div>

      <h3 class="text-[16.5px] sm:text-[18px] font-bold text-brand-text leading-snug">
        <a
          href={projectUrl}
          class="hover:text-brand-secondary transition-colors focus:outline-none"
        >
          {project.title}
        </a>
      </h3>

      <p class="mt-2.5 text-[13.5px] sm:text-[14px] text-brand-secondary line-clamp-2 leading-[1.75]">
        {project.summary}
      </p>
    </div>

    <div class="mt-5 pt-3.5 border-t border-brand-border flex items-center justify-between">
      <span class="text-[11.5px] sm:text-[12px] text-brand-muted">{project.date}</span>
      <a
        href={projectUrl}
        class="inline-flex items-center gap-1.5 text-[12.5px] sm:text-[13px] font-medium text-brand-secondary group-hover:text-brand-text py-1 transition-colors"
      >
        <span>{t.details}</span>
        <span aria-hidden="true" class={`transition-transform duration-150 ${lang === 'fa' ? 'group-hover:-translate-x-1' : 'group-hover:translate-x-1'}`}>
          {t.arrow}
        </span>
      </a>
    </div>
  </div>

</article>