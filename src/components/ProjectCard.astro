---
// src/components/ProjectCard.astro
// دریافت اطلاعات تک‌پروژه از صفحه اصلی
const { project } = Astro.props;
---

<!-- کارت پروژه با انیمیشن شناور شدن و درخشش حاشیه زرد هنگام هاور -->
<a 
  href={`/projects/${project.slug}`} 
  class="group relative flex flex-col bg-zinc-900/40 backdrop-blur-md border border-white/[0.08] rounded-3xl overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 hover:border-amber-400/50 hover:shadow-[0_20px_40px_-15px_rgba(251,191,36,0.12)]"
>
  <!-- بخش تصویر کاور با زوم بسیار نرم -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-zinc-950">
    <img 
      src={project.coverImage} 
      alt={project.title} 
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
    />
    <!-- گرادینت تیره روی عکس برای خوانایی بیشتر -->
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent opacity-80"></div>
    
    <!-- برچسب مقصد روی تصویر -->
    <span class="absolute bottom-3 right-4 bg-black/70 backdrop-blur-md text-amber-400 border border-amber-400/30 text-xs font-medium px-3 py-1 rounded-full">
      مقصد: {project.clientLocation}
    </span>
  </div>

  <!-- بخش متنی کارت -->
  <div class="p-6 flex flex-col flex-grow justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
        <span>{project.category}</span>
        <span>{project.date}</span>
      </div>
      
      <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors duration-300 leading-snug">
        {project.title}
      </h3>
      
      <p class="mt-3 text-sm text-zinc-400 line-clamp-2 leading-relaxed">
        {project.summary}
      </p>
    </div>

    <!-- فوتر کارت (دکمه مشاهده جزئیات) -->
    <div class="mt-6 pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs font-semibold text-amber-400">
      <span>مشاهده مستندات و جزئیات کامل</span>
      <span class="transform transition-transform duration-300 group-hover:-translate-x-1.5 text-base">&larr;</span>
    </div>
  </div>
</a>