---
import { projects } from '../data/projects.js';

const pathname = Astro.url.pathname;
const isPersian = pathname === '/fa' || pathname.startsWith('/fa/');
const currentLang: 'fa' | 'tr' = isPersian ? 'fa' : 'tr';
const targetLang: 'fa' | 'tr' = isPersian ? 'tr' : 'fa';

let targetUrl = isPersian ? '/' : '/fa';

const projectPrefix = isPersian ? '/fa/projects/' : '/projects/';

if (pathname.startsWith(projectPrefix)) {
  const slug = pathname
    .slice(projectPrefix.length)
    .replace(/\/$/, '');

  const currentProject = projects[currentLang].find(
    (project) => project.slug === slug
  );

  if (currentProject) {
    const translatedProject = projects[targetLang].find(
      (project) =>
        project.translationKey === currentProject.translationKey
    );

    if (translatedProject) {
      targetUrl =
        targetLang === 'fa'
          ? `/fa/projects/${translatedProject.slug}`
          : `/projects/${translatedProject.slug}`;
    }
  }
} else if (pathname !== '/' && pathname !== '/fa') {
  targetUrl = isPersian
    ? pathname.replace(/^\/fa(?=\/|$)/, '') || '/'
    : `/fa${pathname}`;
}
---

<a
  href={targetUrl}
  lang={targetLang}
  title={isPersian ? "Türkçe'ye Geç" : 'تغییر زبان به فارسی'}
  aria-label={isPersian ? "Türkçe'ye Geç" : 'تغییر زبان به فارسی'}
  class="inline-flex items-center justify-center"
>
  <span>{targetLang.toUpperCase()}</span>
</a>