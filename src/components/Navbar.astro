---
// src/components/Navbar.astro
import content from '../data/content.json';
import LanguagePicker from './LanguagePicker.astro';

const lang: 'fa' | 'tr' =
  Astro.url.pathname === '/fa' || Astro.url.pathname.startsWith('/fa/')
    ? 'fa'
    : 'tr';

const info = content.companyInfo[lang];
const contact = content.contact;

const ui = {
  fa: {
    subtitle: "بازرگانی و صادرات بین‌المللی",
    btnConsult: "درخواست مشاوره",
    btnConsultWa: "درخواست مشاوره در واتس‌اپ",
    phoneLabel: "تماس مستقیم:",
    links: [
      { label: "صفحه اصلی", href: "/fa" },
      { label: "خدمات", href: "/fa#services" },
      { label: "پروژه‌ها", href: "/fa#projects" },
      { label: "درباره ما", href: "/fa#about" },
      { label: "تماس با ما", href: "#contact" }
    ]
  },
  tr: {
    subtitle: "Uluslararası Ticaret ve İhracat",
    btnConsult: "Danışmanlık Alın",
    btnConsultWa: "WhatsApp'tan Danışmanlık Alın",
    phoneLabel: "Doğrudan Arama:",
    links: [
      { label: "Ana Sayfa", href: "/" },
      { label: "Hizmetler", href: "/#services" },
      { label: "Projeler", href: "/#projects" },
      { label: "Hakkımızda", href: "/#about" },
      { label: "İletişim", href: "#contact" }
    ]
  }
};
const t = ui[lang];
---

<header class="sticky top-0 z-40 bg-brand-bg/95 backdrop-blur-md border-b border-brand-border">
  <div class="container-editorial h-[64px] sm:h-[72px] flex items-center justify-between gap-3">
    
    <a href={lang === 'fa' ? '/fa' : '/'} class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none min-w-0">
      <div class="w-[34px] h-[34px] shrink-0 rounded-[8px] bg-brand-surface border border-brand-border-strong flex items-center justify-center text-brand-text font-bold text-[15px] transition-colors group-hover:border-brand-secondary">
        {lang === 'fa' ? 'آ' : 'A'}
      </div>
      <div class="flex flex-col min-w-0">
        <span class="text-[14.5px] sm:text-[15.5px] font-bold text-brand-text leading-tight truncate">{info.name}</span>
        <span class="text-[10.5px] sm:text-[11px] text-brand-muted leading-none mt-1 truncate">{t.subtitle}</span>
      </div>
    </a>

    <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-8">
      {t.links.map((item) => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <LanguagePicker />
      <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex btn-primary-sm">
        {t.btnConsult}
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Menu"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-[9px] bg-brand-surface border border-brand-border-strong text-brand-text active:scale-95 transition-all"
      >
        <svg id="icon-menu-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg id="icon-menu-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <!-- منوی کشویی موبایل با انیمیشن نرم -->
  <nav
    id="mobile-navigation"
    aria-label="Mobile Navigation"
    class="mobile-drawer md:hidden bg-brand-surface border-b border-brand-border"
  >
    <div class="mobile-drawer-inner">
      <div class="container-editorial py-4 flex flex-col">
        {t.links.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link flex items-center justify-between text-[15px] font-medium text-brand-secondary hover:text-brand-text active:bg-brand-elevated/50 px-2 py-3.5 rounded-[8px] border-b border-brand-border/50 last:border-b-0 transition-colors"
          >
            <span>{item.label}</span>
            <span class="text-brand-muted text-xs" aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span>
          </a>
        ))}

        <div class="pt-4 mt-2 border-t border-brand-border flex flex-col gap-2.5">
          <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="w-full btn-primary">
            {t.btnConsultWa}
          </a>
          <a href={contact.phoneHref} class="w-full btn-outline !min-h-[42px] !py-2 text-[13px]">
            <span>{t.phoneLabel}</span>
            <span dir="ltr" class="font-semibold">{contact.phoneDisplay}</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileNav = document.getElementById('mobile-navigation');
    const iconOpen = document.getElementById('icon-menu-open');
    const iconClose = document.getElementById('icon-menu-close');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !mobileNav) return;

    const setMenuState = (isOpen) => {
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      mobileNav.classList.toggle('is-open', isOpen);
      iconOpen?.classList.toggle('hidden', isOpen);
      iconClose?.classList.toggle('hidden', !isOpen);
    };

    toggleBtn.addEventListener('click', () => {
      const currentlyOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      setMenuState(!currentlyOpen);
    });

    links.forEach((link) => {
      link.addEventListener('click', () => setMenuState(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setMenuState(false);
        toggleBtn.focus();
      }
    });
  })();
</script>