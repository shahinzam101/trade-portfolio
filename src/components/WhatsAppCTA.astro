---
// src/components/WhatsAppCTA.astro
import { companyInfo } from '../data/projects.js';

const { hideSection = false } = Astro.props;
---

{!hideSection && (
  <section id="contact" class="py-16 sm:py-20 border-t border-[#27272A] bg-[#121214]">
    <div class="container-editorial">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
        
        <div class="max-w-xl">
          <h2 class="text-[24px] sm:text-[28px] font-bold text-[#F4F4F5] leading-snug">
            برای تأمین کالا یا هماهنگی فرآیند صادرات به مشاوره نیاز دارید؟
          </h2>
          <p class="text-[15px] text-[#A1A1AA] mt-2.5 leading-relaxed">
            درباره نیاز تجاری، مقصد صادراتی یا شرایط ترخیص محموله خود با کارشناسان {companyInfo.name} گفتگو کنید تا امکان و نحوه همکاری بررسی شود.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <a
            href={companyInfo.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 bg-[#D6A52A] hover:bg-[#E0B23A] text-[#0B0B0C] font-semibold text-[14px] px-6 py-3.5 rounded-[10px] transition-editorial"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
            </svg>
            <span>گفتگو در واتس‌اپ</span>
          </a>

          <a
            href={companyInfo.phoneHref}
            class="inline-flex items-center justify-center bg-[#18181B] hover:bg-[#27272A] text-[#F4F4F5] border border-[#27272A] font-medium text-[14px] px-5 py-3.5 rounded-[10px] transition-editorial"
          >
            تماس تلفنی: {companyInfo.phoneDisplay}
          </a>
        </div>

      </div>
    </div>
  </section>
)}

<!-- دکمه شناور واتس‌اپ: کوچک، کم‌حجم، بدون Glow و با فاصله امن از لبه‌ها -->
<div class="fixed bottom-4 left-4 sm:bottom-6 sm:left-6 z-30">
  <a
    href={companyInfo.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="ارتباط سریع از طریق واتس‌اپ"
    class="inline-flex items-center gap-2 bg-[#18181B]/95 backdrop-blur-sm border border-[#3F3F46] hover:border-[#D6A52A] text-[#F4F4F5] px-3.5 py-2.5 rounded-[10px] transition-editorial"
  >
    <svg class="w-4 h-4 text-[#D6A52A] fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
    </svg>
    <span class="text-[12px] font-medium">مشاوره واتس‌اپ</span>
  </a>
</div>