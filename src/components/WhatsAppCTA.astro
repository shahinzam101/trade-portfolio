---
// src/components/WhatsAppCTA.astro
import { companyInfo } from '../data/projects.js';
---

<!-- ۱. سکشن دعوت به مذاکره تجاری در انتهای صفحه -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 reveal">
  <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-br from-zinc-900 via-zinc-950 to-black border border-amber-400/30 p-7 sm:p-12 shadow-2xl">
    
    <!-- هاله نوری طلایی و سبز ملایم در پس‌زمینه کارت -->
    <div class="absolute -right-20 -bottom-20 w-72 h-72 bg-amber-400/15 blur-[100px] pointer-events-none"></div>
    <div class="absolute -left-20 -top-20 w-72 h-72 bg-emerald-500/10 blur-[100px] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
      <div class="max-w-xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-3 py-1 rounded-full mb-4">
          پاسخگویی مستقیم مدیریت بازرگانی
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight">
          برای صادرات یا تأمین کالا نیاز به مشاوره دارید؟
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base mt-3 leading-relaxed">
          از استعلام قیمت و شرایط ترخیص گمرکی تا هماهنگی حمل‌ونقل بین‌المللی؛ مستقیماً از طریق واتس‌اپ با کارشناسان <strong class="text-zinc-200">{companyInfo.name}</strong> در ارتباط باشید.
        </p>
      </div>

      <div class="w-full lg:w-auto flex flex-col sm:flex-row gap-4">
        <a 
          href={companyInfo.whatsapp}
          target="_blank"
          class="flex items-center justify-center gap-3 bg-gradient-to-l from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-black font-extrabold text-sm sm:text-base px-8 py-4 rounded-2xl transition-all duration-300 shadow-[0_10px_30px_rgba(251,191,36,0.3)] hover:scale-[1.02] active:scale-95"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
          </svg>
          <span>شروع گفتگو در واتس‌اپ</span>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- ۲. دکمه شناور به سبک Apple Dynamic Island در پایین صفحه -->
<div class="fixed bottom-5 left-5 z-50">
  <a 
    href={companyInfo.whatsapp}
    target="_blank"
    aria-label="ارتباط در واتس‌اپ"
    class="group flex items-center gap-3 bg-zinc-900/85 backdrop-blur-xl border border-amber-400/40 hover:border-amber-400 pr-2.5 pl-4 py-2 rounded-full shadow-[0_10px_35px_rgba(0,0,0,0.8)] transition-all duration-300 hover:scale-105 active:scale-95"
  >
    <div class="relative w-9 h-9 rounded-full bg-amber-400 flex items-center justify-center text-black shadow-md">
      <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 border-2 border-zinc-900 rounded-full"></span>
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
      </svg>
    </div>
    <div class="text-right">
      <span class="block text-xs font-bold text-white group-hover:text-amber-400 transition-colors">واتس‌اپ بازرگانی</span>
      <span class="block text-[10px] text-zinc-400">پاسخگویی سریع</span>
    </div>
  </a>
</div>