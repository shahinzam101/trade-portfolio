---
// src/components/WhatsAppCTA.astro
import { companyInfo } from '../data/projects.js';

const lang = (Astro.currentLocale || 'tr') as 'fa' | 'tr';
const info = companyInfo[lang];
const { hideSection = false } = Astro.props;

const ui = {
  fa: {
    h2: "برای تأمین کالا یا هماهنگی فرآیند صادرات به مشاوره نیاز دارید؟",
    p: `درباره نیاز تجاری، مقصد صادراتی یا شرایط ترخیص محموله خود با کارشناسان ${info.name} گفتگو کنید تا امکان و نحوه همکاری بررسی شود.`,
    btn: "گفت‌وگو در واتس‌اپ",
    call: "تماس تلفنی:",
    floatBtn: "مشاوره واتس‌اپ"
  },
  tr: {
    h2: "Tedarik veya ihracat süreci koordinasyonu için danışmanlığa mı ihtiyacınız var?",
    p: `Ticari ihtiyaçlarınız, ihracat hedefiniz veya sevkiyatınızın gümrükleme şartları hakkında ${info.name} uzmanlarıyla görüşerek işbirliği olanaklarını değerlendirin.`,
    btn: "WhatsApp'ta Görüşün",
    call: "Telefon Numarası:",
    floatBtn: "WhatsApp Danışma"
  }
};
const t = ui[lang];
---

{!hideSection && (
  <section id="contact" class="py-16 sm:py-20 bg-brand-elevated/60">
    <div class="container-editorial">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
        
        <div class="max-w-xl">
          <h2 class="text-[24px] sm:text-[28px] font-bold text-brand-text leading-snug">{t.h2}</h2>
          <p class="text-[15px] text-brand-secondary mt-2.5 leading-relaxed">{t.p}</p>
        </div>

        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <a href={companyInfo.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/></svg>
            <span>{t.btn}</span>
          </a>

          <a href={companyInfo.phoneHref} class="btn-outline">
            <span>{t.call} {companyInfo.phoneDisplay}</span>
          </a>
        </div>

      </div>
    </div>
  </section>
)}

<div class="fixed bottom-4 left-4 sm:bottom-5 sm:left-5 z-30">
  <a href={companyInfo.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="ارتباط سریع از طریق واتس‌اپ" class="inline-flex items-center gap-2 bg-brand-surface hover:bg-brand-elevated border border-brand-border-strong text-brand-secondary hover:text-brand-text px-3 py-2 rounded-[8px] transition-colors">
    <svg class="w-4 h-4 text-brand-text fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/></svg>
    <span class="text-[12px] font-medium">{t.floatBtn}</span>
  </a>
</div>