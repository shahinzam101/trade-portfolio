---
// src/components/Hero.astro
import { companyInfo } from '../data/projects.js';
---

<section class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-20 pb-16 sm:pb-24 border-b border-white/[0.07] bg-apple-grid">
  
  <!-- چیدمان دو ستونه در دسکتاپ و تک‌ستونه استاندارد در موبایل -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    
    <!-- ستون سمت راست: متن اصلی، دکمه‌ها و آمار (۷ واحد از ۱۲ واحد) -->
    <div class="lg:col-span-7 reveal active text-right">
      
      <!-- بج کپسولی بالای تیتر -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-400/10 border border-amber-400/25 text-amber-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
        <span>تجارت بین‌المللی با استانداردهای جهانی</span>
      </div>

      <!-- تیتر اصلی بهینه‌شده برای موبایل و دسکتاپ -->
      <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold tracking-tight leading-[1.25] text-white">
        {companyInfo.name}؛ <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-l from-amber-200 via-amber-400 to-amber-500">
          {companyInfo.slogan}
        </span>
      </h1>

      <!-- توضیحات شرکت -->
      <p class="mt-5 text-sm sm:text-base lg:text-lg text-zinc-400 leading-8 font-normal">
        {companyInfo.description}
      </p>

      <!-- دکمه‌های اقدام سریع (CTA) به سبک اپل -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
        <a 
          href={companyInfo.whatsapp}
          target="_blank"
          class="inline-flex items-center justify-center gap-2.5 bg-amber-400 hover:bg-amber-300 text-black font-bold text-sm px-7 py-4 rounded-2xl transition-all duration-300 shadow-[0_0_30px_rgba(251,191,36,0.3)] hover:shadow-[0_0_40px_rgba(251,191,36,0.5)] active:scale-95"
        >
          <!-- آیکون واتساپ -->
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
          </svg>
          <span>استعلام و مشاوره در واتس‌اپ</span>
        </a>

        <a 
          href="#projects" 
          class="inline-flex items-center justify-center gap-2 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 border border-white/[0.1] font-semibold text-sm px-6 py-4 rounded-2xl transition-all duration-300"
        >
          <span>مشاهده محموله‌های صادراتی</span>
          <span>&darr;</span>
        </a>
      </div>

      <!-- آمار و ارقام کلیدی -->
      <div class="grid grid-cols-3 gap-4 sm:gap-8 mt-12 pt-8 border-t border-white/[0.08]">
        <div>
          <span class="block text-2xl sm:text-3xl font-extrabold text-amber-400">+۱۰۰</span>
          <span class="text-[11px] sm:text-xs text-zinc-400 mt-1 block">محموله موفق صادراتی</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-extrabold text-amber-400">۵ کشور</span>
          <span class="text-[11px] sm:text-xs text-zinc-400 mt-1 block">مقصد فعال تجاری</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-extrabold text-amber-400">۱۰۰٪</span>
          <span class="text-[11px] sm:text-xs text-zinc-400 mt-1 block">تضمین سلامت بار</span>
        </div>
      </div>

    </div>

    <!-- ستون سمت چپ: ویترین شیشه‌ای اپل (Bento Card) برای پر کردن فضای خالی -->
    <div class="lg:col-span-5 reveal delay-200">
      <div class="relative rounded-3xl bg-gradient-to-b from-zinc-900/90 to-zinc-950/90 backdrop-blur-2xl border border-white/[0.1] p-6 sm:p-7 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)]">
        
        <!-- نور طلایی پشت کارت -->
        <div class="absolute -top-10 -left-10 w-40 h-40 bg-amber-400/15 blur-3xl pointer-events-none rounded-full"></div>

        <!-- هدر کارت شیشه‌ای -->
        <div class="flex items-center justify-between pb-5 mb-5 border-b border-white/[0.08]">
          <div>
            <span class="text-xs text-amber-400 font-bold block">شبکه لجستیک و ترخیص</span>
            <h3 class="text-base font-bold text-white mt-0.5">کریدورهای فعال صادراتی</h3>
          </div>
          <span class="inline-flex items-center gap-1.5 text-[11px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-1 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            فعال
          </span>
        </div>

        <!-- لیست مسیرهای صادراتی به سبک ویجت‌های macOS -->
        <div class="space-y-3.5">
          
          <div class="flex items-center justify-between p-3.5 rounded-2xl bg-black/50 border border-white/[0.06] hover:border-amber-400/40 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amber-400/10 border border-amber-400/20 flex items-center justify-center text-amber-400 font-bold text-sm">
                TR
              </div>
              <div>
                <div class="text-sm font-bold text-white">مرز بازرگان &larr; استانبول</div>
                <div class="text-xs text-zinc-400 mt-0.5">ترانزیت زمینی و ترخیص ۲۴ ساعته</div>
              </div>
            </div>
            <span class="text-xs font-semibold text-amber-400 bg-amber-400/10 px-2.5 py-1 rounded-lg">ترکیه</span>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-2xl bg-black/50 border border-white/[0.06] hover:border-amber-400/40 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amber-400/10 border border-amber-400/20 flex items-center justify-center text-amber-400 font-bold text-sm">
                GE
              </div>
              <div>
                <div class="text-sm font-bold text-white">مرز جلفا / نوردوز &larr; تفلیس</div>
                <div class="text-xs text-zinc-400 mt-0.5">حمل جامبوبگ و مواد معدنی</div>
              </div>
            </div>
            <span class="text-xs font-semibold text-amber-400 bg-amber-400/10 px-2.5 py-1 rounded-lg">گرجستان</span>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-2xl bg-black/50 border border-white/[0.06] hover:border-amber-400/40 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-amber-400/10 border border-amber-400/20 flex items-center justify-center text-amber-400 font-bold text-sm">
                IQ
              </div>
              <div>
                <div class="text-sm font-bold text-white">مرز تمرچین / باشماق &larr; اربیل</div>
                <div class="text-xs text-zinc-400 mt-0.5">کانتینری و پالت‌بندی تخصصی</div>
              </div>
            </div>
            <span class="text-xs font-semibold text-amber-400 bg-amber-400/10 px-2.5 py-1 rounded-lg">عراق</span>
          </div>

        </div>

        <!-- باکس پایین کارت شیشه‌ای -->
        <div class="mt-5 pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs text-zinc-400">
          <span>پشتیبانی کامل امور گمرکی از مبدأ تا مقصد</span>
          <span class="text-amber-400 font-bold">Door-to-Door</span>
        </div>

      </div>
    </div>

  </div>

</section>