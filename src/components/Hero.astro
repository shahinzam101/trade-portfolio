---
// src/components/Hero.astro
import { companyInfo, tradeCorridors } from '../data/projects.js';
---

<section class="border-b border-[#27272A] py-14 sm:py-20 lg:py-24">
  <div class="container-editorial">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
      
      <!-- ستون اصلی: معرفی شرکت و فراخوان اقدام (7 ستون) -->
      <div class="lg:col-span-7 text-right">
        
        <p class="text-[13px] font-medium text-[#D6A52A] tracking-wide mb-4">
          {companyInfo.legalTitle}
        </p>

        <h1 class="text-[32px] sm:text-[44px] lg:text-[52px] font-bold text-[#F4F4F5] leading-[1.25] tracking-tight">
          {companyInfo.tagline}
        </h1>

        <p class="mt-6 text-[15px] sm:text-[17px] text-[#A1A1AA] leading-[1.85] max-w-2xl">
          {companyInfo.description}
        </p>

        <!-- دکمه‌های اقدام (یک دکمه اصلی + یک لینک ثانویه متنی) -->
        <div class="mt-9 flex flex-wrap items-center gap-6">
          <a
            href={companyInfo.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center bg-[#D6A52A] hover:bg-[#E0B23A] text-[#0B0B0C] font-semibold text-[14px] px-6 py-3.5 rounded-[10px] transition-editorial"
          >
            درخواست مشاوره بازرگانی
          </a>

          <a
            href="#projects"
            class="inline-flex items-center gap-2 text-[14px] font-medium text-[#F4F4F5] hover:text-[#D6A52A] py-2 transition-editorial group"
          >
            <span>مشاهده پروژه‌ها</span>
            <span aria-hidden="true" class="transition-transform duration-150 group-hover:-translate-x-1">&larr;</span>
          </a>
        </div>

        <!-- شاخص‌های عملیاتی شرکت (ساده، مستند و بدون ادعاهای تبلیغاتی) -->
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-12 pt-8 border-t border-[#27272A]">
          {companyInfo.operationalHighlights.map((item) => (
            <div>
              <dt class="text-[12px] text-[#71717A]">{item.label}</dt>
              <dd class="text-[16px] font-bold text-[#F4F4F5] mt-1">{item.value}</dd>
              <p class="text-[12px] text-[#A1A1AA] mt-0.5">{item.note}</p>
            </div>
          ))}
        </dl>

      </div>

      <!-- ستون کناری: فهرست مسیرها و حوزه‌های عملیاتی (5 ستون - ساختار Editorial) -->
      <aside aria-label="مسیرهای عملیاتی صادرات" class="lg:col-span-5 w-full">
        <div class="bg-[#121214] border border-[#27272A] rounded-[14px] p-6 sm:p-7">
          
          <div class="pb-4 mb-5 border-b border-[#27272A]">
            <h2 class="text-[17px] font-bold text-[#F4F4F5]">
              مسیرها و کریدورهای عملیاتی
            </h2>
            <p class="text-[13px] text-[#A1A1AA] mt-1">
              مقاصد اصلی صادرات و گمرکات خروجی تحت پوشش شرکت
            </p>
          </div>

          <ul class="divide-y divide-[#27272A]">
            {tradeCorridors.map((corridor) => (
              <li class="py-4 first:pt-0 last:pb-0">
                <div class="flex items-baseline justify-between gap-2">
                  <h3 class="text-[15px] font-semibold text-[#F4F4F5]">
                    {corridor.destination}
                  </h3>
                  <span class="text-[12px] text-[#A1A1AA] shrink-0">
                    {corridor.border}
                  </span>
                </div>
                <p class="text-[13px] text-[#A1A1AA] mt-1.5 leading-relaxed">
                  {corridor.serviceType}
                </p>
                {corridor.relatedProjectSlug && (
                  <a
                    href={`/projects/${corridor.relatedProjectSlug}`}
                    class="inline-flex items-center gap-1.5 text-[12px] font-medium text-[#D6A52A] hover:underline mt-2"
                  >
                    <span>مشاهده نمونه محموله</span>
                    <span aria-hidden="true">&larr;</span>
                  </a>
                )}
              </li>
            ))}
          </ul>

        </div>
      </aside>

    </div>

  </div>
</section>